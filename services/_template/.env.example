# Copy to `.env` for local dev. The service boots with safe defaults if this is
# absent — these are the production-relevant overrides. See SERVICE_BLOCK_PATTERN.md §3.

# --- Service identity ---
BLOCK_ID=__BLOCK_ID__
ENVIRONMENT=local
DEBUG=true

# --- Host <-> service auth (HS256 JWT) ---
# In production set this to the host CRM's SECRET_KEY (or a shared mesh secret).
SERVICE_TOKEN_SECRET=change-me-to-a-32-plus-char-secret-value
ALGORITHM=HS256
SERVICE_TOKEN_TTL_SECONDS=300

# --- Host CRM callback target ---
HOST_API_URL=http://localhost:8000
HOST_EVENT_WEBHOOK_PATH=/webhooks/service/__BLOCK_ID__

# --- Fernet vault (only if the service owns a slice that stores ciphertext) ---
# Must equal the host's ENCRYPTION_KEY when decrypting per-workspace credentials.
ENCRYPTION_KEY=change-me-in-production

# --- Optional infra (own a slice DB / use Redis) ---
# DATABASE_URL=postgresql+asyncpg://aicrm:aicrm_dev_password@localhost:5432/aicrm
# REDIS_URL=redis://localhost:6379/0

# --- External provider webhooks ---
SKIP_WEBHOOK_VERIFICATION=false

# --- Worker ---
RUN_WORKER=true
WORKER_POLL_INTERVAL_SECONDS=30
